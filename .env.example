# Database
DATABASE_URL="postgresql://coach:securepassword@db:5432/travel_baseball?schema=public"
DB_PASSWORD="securepassword"

# NextAuth
NEXTAUTH_URL="http://localhost:7373"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# App Configuration
NODE_ENV="production"
PORT=3000

# Redis
REDIS_URL="redis://redis:6379"

# Weather API (optional - OpenWeatherMap)
WEATHER_API_KEY="your-openweathermap-api-key"

# File Upload
MAX_FILE_SIZE="10485760"
UPLOAD_DIR="/app/uploads"

# Google Gemini API (for document parsing)
GEMINI_API_KEY="your-gemini-api-key-here"

# Admin Setup (created automatically on first boot)
ADMIN_EMAIL="coach@example.com"
ADMIN_PASSWORD="changeme123"
ADMIN_NAME="Head Coach"
TEAM_NAME="Your Team Name"
